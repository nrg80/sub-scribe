<Project>
    <PropertyGroup>
        <ScribeRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</ScribeRepoRoot>
        <Version>12.1.11.5</Version>
        <AssemblyVersion>12.1.11.5</AssemblyVersion>
        <FileVersion>12.1.11.5</FileVersion>
    </PropertyGroup>

    <!-- Testprojekte unter scripts/ bekommen die Repo-Wurzel als Konstante, statt eines
         fest verdrahteten Pfads. Geschrieben wird sie beim Bauen, nicht von Hand gepflegt. -->
    <Target Name="ScribeWriteRepoRoot" BeforeTargets="BeforeCompile"
            Condition="$(MSBuildProjectDirectory.Contains('scripts'))">
        <PropertyGroup>
            <ScribeRepoPathsFile>$(IntermediateOutputPath)ScribeRepoPaths.g.cs</ScribeRepoPathsFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(ScribeRepoPathsFile)"
                          Lines="internal static class ScribeRepoPaths { internal const string Root = @&quot;$(ScribeRepoRoot)&quot;%3B }"
                          Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <Compile Include="$(ScribeRepoPathsFile)" />
        </ItemGroup>
    </Target>
</Project>
